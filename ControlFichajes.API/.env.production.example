ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3306;Database=tesis_db;Uid=REEMPLAZAR;Pwd=REEMPLAZAR;

Jwt__Key=REEMPLAZAR_POR_UNA_CLAVE_LARGA_Y_SEGURA
Jwt__Issuer=ControlFichajes.API
Jwt__Audience=ControlFichajes.Frontend
Jwt__ExpireMinutes=60
Jwt__RefreshExpireDays=14
Jwt__AgentExpireMinutes=1440
# Definir recién cuando el panel consuma refresh. No cambia el login actual.
# Jwt__AccessExpireMinutes=15

# Queda apagado. No poner true en archivos versionados; un laboratorio local puede
# habilitarlo solo en configuración no versionada.
Auth__PermitirBootstrap=false
Auth__PermitirAltaConPassword=true
Auth__ExigirMfa=false
Auth__MfaGraciaDias=14
Auth__InvitacionHoras=72
Auth__RecuperacionHoras=1
Auth__TotpProtectionKey=REEMPLAZAR_BASE64_DE_32_BYTES

App__PublicBaseUrl=https://REEMPLAZAR

Smtp__Host=REEMPLAZAR
Smtp__Port=587
Smtp__User=REEMPLAZAR
Smtp__Password=REEMPLAZAR
Smtp__From=REEMPLAZAR
Smtp__EnableSsl=true

Cors__AllowedOrigins__0=http://localhost:5173

# La IP auditada sale de la conexión directa. Estos encabezados solo se aceptan
# si Habilitado=true y hay al menos un proxy o una red explícitos. X-Real-IP no se lee.
# No completar con direcciones reales en el repositorio.
ForwardedHeaders__Habilitado=false
# ForwardedHeaders__KnownProxies__0=
# ForwardedHeaders__KnownNetworks__0=